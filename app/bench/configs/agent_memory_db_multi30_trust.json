{
  "system": {
    "name": "dsh_agent_memory",
    "params": {
      "model": "openai/deepseek-v4.1-flash",
      "api_base": "https://opencode.ai/inference/go/v1",
      "memory_enabled": true,
      "keep_history": true,
      "dream_every": 10,
      "dream_ratio": 0.75,
      "memory_trust": true
    }
  },
  "task": {
    "name": "database_exploration",
    "params": {
      "schedule": "multi_group"
    }
  },
  "runs": 1,
  "max_workers": 1,
  "run_mode": "replicate"
}
